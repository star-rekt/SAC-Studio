{
  "name": "sac-email-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Internal campaign design studio for Steep & Cheap",
  "author": "Steep & Cheap",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "app": "vite",
    "ai": "node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:templates": "node --import tsx scripts/check-templates.ts",
    "check:boards": "node scripts/check-three-boards.mjs",
    "check:export": "node --import tsx scripts/check-figma-export.ts",
    "check": "npm run typecheck && npm run check:templates && npm run check:boards && npm run check:export && npm run build",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs && npm --prefix plugin run build",
    "desktop": "npm run build:desktop && electron .",
    "package:mac": "npm run build:desktop && electron-builder --mac pkg",
    "package:win": "npm run build:desktop && electron-builder --win nsis",
    "preview": "vite preview",
    "photos": "node scripts/fetch-photos.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
